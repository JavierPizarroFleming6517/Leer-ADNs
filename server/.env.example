# ---------------------------------------------------------------------------
# TrazaGen · configuración del servidor (server/.env)
# "npm run setup" crea server/.env a partir de este archivo y genera los secretos
# y las llaves que falten. Este archivo de ejemplo nunca debe contener secretos reales.
# ---------------------------------------------------------------------------

# PostgreSQL. Para Neon usa la cadena directa (no la del pooler) con sslmode=require.
DATABASE_URL=postgresql://trazagen:trazagen@localhost:5432/trazagen?schema=public

# URL pública de la app web. Es la base de los QR: {APP_URL}/s/{codigo}.{firma}
# Para escanear desde un celular en la misma red, usa la IP de este equipo, p. ej. http://192.168.1.20:5173
APP_URL=http://localhost:5173

# Orígenes permitidos por CORS (separados por coma). Por defecto, APP_URL.
CORS_ORIGINS=

PORT=3000

# Sesiones (JWT HS256). Mínimo 32 caracteres. Expiración, p. ej. 8h.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Contraseña común de los 4 usuarios de demostración (la usa la siembra).
DEMO_PASSWORD=

# Cifrado de datos personales (AES-256-GCM) e índice ciego (HMAC-SHA256). 32 bytes en base64 cada una.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Llaves Ed25519 para firmar QR y vínculos dactilogenéticos (DER en base64: PKCS#8 la privada, SPKI la pública).
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# Microservicio biométrico (Java + SourceAFIS) y umbral de coincidencia.
AFIS_URL=http://127.0.0.1:7070
AFIS_THRESHOLD=40
