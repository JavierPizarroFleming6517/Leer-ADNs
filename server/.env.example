# Cadena directa de Neon (PostgreSQL). Pégala sin comillas.
# En el panel de Neon, usa la conexión directa para migraciones, no la del pooler.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Secreto para firmar el JWT de demostración. Mínimo 16 caracteres.
# Puedes generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contraseñas de la demo. Deben ser distintas entre sí.
# No las subas al repositorio ni las uses con datos reales.
DEMO_ADMIN_PASSWORD=
DEMO_READER_PASSWORD=

# URL del frontend lector. El QR apuntará a {READER_BASE_URL}/q/{token}
# Para escanear desde un teléfono, usa la IP de esta computadora, por ejemplo:
# READER_BASE_URL=http://192.168.1.20:5174
READER_BASE_URL=http://localhost:5174

PORT=3000
