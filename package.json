{
  "name": "trazagen",
  "private": true,
  "description": "TrazaGen · Plataforma de identificación dactilogenética (demo)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n afis,api,web -c magenta,blue,green \"node scripts/afis-dev.mjs\" \"npm run start:dev --prefix server\" \"npm run dev --prefix client/web\"",
    "demo:reset": "node scripts/reset.mjs",
    "demo:alterar": "npm run demo:alterar --prefix server",
    "test": "npm test --prefix server",
    "test:afis": "node scripts/evaluar-afis.mjs",
    "test:e2e": "node e2e/guion.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
